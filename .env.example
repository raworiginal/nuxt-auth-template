# For Docker
POSTGRES_DB=ProjectDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# Drizzle
DATABASE_URL=postgres://postgres:change_me_in_production@localhost:5432/ProjectDB

# Better Auth (at least 32 characters)
BETTER_AUTH_SECRET=your-secret-goes-here
# Set this for custom production domains or deployments without an inferred URL.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
