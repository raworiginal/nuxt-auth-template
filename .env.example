# For Docker
POSTGRES_DB=ProjectDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_locally

# Drizzle
DATABASE_URL=postgres://postgres:change_me_locally@localhost:5432/ProjectDB

# Nuxt app secret (at least 32 characters; also used by Better Auth and pnpm auth:setup)
NUXT_APP_SECRET=replace-with-output-from-openssl-rand-base64-32
# Set this for custom production domains or deployments without an inferred URL.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial admin account
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters

# Optional social sign-in (configure in Google/GitHub OAuth app settings).
# The callback URLs are http://localhost:3000/api/auth/callback/google and
# http://localhost:3000/api/auth/callback/github respectively.
# NUXT_GOOGLE_CLIENT_ID=
# NUXT_GOOGLE_CLIENT_SECRET=
# NUXT_GITHUB_CLIENT_ID=
# NUXT_GITHUB_CLIENT_SECRET=
